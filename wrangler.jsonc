// Cloudflare Workers (static assets) — Savvytrix Solutions landing.
// Every route is prerendered at build time (app.routes.server.ts → RenderMode.Prerender),
// so only dist/savvy-landing/browser is deployed. The Express server (src/server.ts) is
// not used in production; it remains for local `npm run serve:ssr:savvy-landing`.
{
  "name": "savvytrix-site",
  "compatibility_date": "2026-09-01",
  // Worker: /api/contacto (formulario → panel + correo) y las páginas, a las que les agrega el
  // contenido del panel Savvy Sites (vitrina, planes, preguntas). JS/CSS/imágenes: directo.
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist/savvy-landing/browser",
    "binding": "ASSETS",
    // Todo pasa por el worker para redirigir http/www al dominio oficial (JS/CSS/imágenes: directo a los archivos).
    "run_worker_first": true,
    // /privacidad → privacidad/index.html without redirecting to /privacidad/ (matches sitemap)
    "html_handling": "drop-trailing-slash",
    // Direcciones que no existen → public/404.html con código 404 (antes devolvían la portada con 200:
    // "404 falso" para Google). Todas las rutas reales están prerenderizadas.
    "not_found_handling": "404-page"
  },
  // Correo del formulario. El destino va en el secreto LEAD_TO (dirección verificada en
  // Email Routing de la cuenta) para no dejar el correo escrito en el repositorio.
  "send_email": [{ "name": "LEAD_MAIL" }],
  "routes": [
    { "pattern": "savvytrix.com", "custom_domain": true },
    { "pattern": "www.savvytrix.com", "custom_domain": true }
  ]
}
